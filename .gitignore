.DS_Store
.Rhistory
.RData
.Rproj.user/

# Backup data (not needed for sharing).
data/processed_backup/

# Temporary files generated by R or macOS.
*.tmp
*.log

# ── Large raw data files (>10 MB, excluded from git) ──────────────────────────
# TCGA GDC raw object (353 MB). Download from https://portal.gdc.cancer.gov/
# or contact the authors. See the .desc.txt file for details.
data/external/01_tcga_expression_clinical/luad.gdc_2022.rda

# ── Processed intermediates ────────────────────────────────────────────────────
# All files in data/processed/ are generated by running the scripts in order.
# Only the folder skeleton (with .gitkeep sentinels) is tracked.
data/processed/**
!data/processed/**/
!data/processed/**/.gitkeep
